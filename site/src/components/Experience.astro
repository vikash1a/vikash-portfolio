---
const jobs = [
  {
    company: 'Blink Health',
    title: 'Senior Software Engineer',
    period: 'Jul 2025 – Present',
    location: 'Remote',
    bullets: [],
  },
  {
    company: 'Toast',
    title: 'Software Engineer 2',
    period: 'Nov 2022 – Jul 2025',
    location: 'Remote',
    bullets: [
      'Built identity platform features including SSO, OAuth 2.0 flows, and MFA across Toast\'s restaurant POS ecosystem.',
      'Led data migration initiatives for payment credentials and user account consolidation.',
      'Improved auth service reliability and reduced on-call incidents through observability improvements (New Relic, Datadog, Splunk).',
    ],
  },
  {
    company: 'Bajaj Finance',
    title: 'Sr. Software Engineer',
    period: 'Jul 2020 – Oct 2022',
    location: 'Pune, India',
    bullets: [
      'Engineered backend services for consumer lending workflows handling millions of applications.',
      'Implemented RLS-based data isolation and Okta-integrated SSO for internal platforms.',
      'Built event-driven pipelines using Apache Pulsar and Apache Camel for payment processing.',
    ],
  },
  {
    company: 'Flow Edge',
    title: 'Software Engineering Intern',
    period: 'May 2019 – Jul 2019',
    location: 'India',
    bullets: [],
  },
];
---
<section id="experience" class="container">
  <h2>Experience</h2>
  <div class="jobs">
    {jobs.map(job => (
      <article class="job">
        <div class="job-header">
          <div>
            <span class="company">{job.company}</span>
            <span class="job-title">{job.title}</span>
          </div>
          <div class="meta">
            <span class="period">{job.period}</span>
            <span class="loc">{job.location}</span>
          </div>
        </div>
        {job.bullets.length > 0 && (
          <ul class="bullets">
            {job.bullets.map(b => <li>{b}</li>)}
          </ul>
        )}
      </article>
    ))}
  </div>
</section>

<style>
  .jobs { display: flex; flex-direction: column; gap: 2rem; }
  .job-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .company {
    display: block;
    font-weight: 600;
    font-size: 1rem;
    color: var(--text);
  }
  .job-title {
    display: block;
    font-size: 0.9rem;
    color: var(--accent-light);
  }
  .meta {
    text-align: right;
  }
  .period {
    display: block;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .loc {
    display: block;
    font-size: 0.8rem;
    color: var(--muted);
    opacity: 0.7;
  }
  .bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-left: 0;
  }
  .bullets li {
    font-size: 0.92rem;
    color: #444;
    padding-left: 1.1rem;
    position: relative;
    line-height: 1.6;
  }
  .bullets li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--muted);
  }
</style>
