---
import data from '../data/resume.json';
const { experience } = data;
---
<section id="experience" class="container">
  <p class="section-label">Experience</p>
  <div class="jobs">
    {experience.map(job => (
      <article class:list={['job', { current: job.current }]}>
        <div class="job-header">
          <div class="job-left">
            <span class="company">{job.company}</span>
            <span class="job-title">{job.title}</span>
          </div>
          <div class="job-right">
            {job.current && <span class="badge">Current</span>}
            <span class="period">{job.period}</span>
            <span class="loc">{job.location}</span>
          </div>
        </div>
        {job.bullets.length > 0 && (
          <ul class="bullets">
            {job.bullets.map(b => <li>{b}</li>)}
          </ul>
        )}
      </article>
    ))}
  </div>
</section>

<style>
  section { background: var(--bg-white); }
  .jobs { display: flex; flex-direction: column; gap: 1rem; }

  .job {
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-left: 3px solid var(--border);
    border-radius: var(--radius);
    padding: 1.4rem 1.5rem;
    transition: border-left-color 0.2s, box-shadow 0.2s;
  }
  .job:hover { border-left-color: var(--accent); box-shadow: var(--shadow); }
  .job.current { border-left-color: var(--accent); background: var(--accent-subtle); }

  .job-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .job-header:has(+ .bullets) { margin-bottom: 1rem; }

  .job-left { display: flex; flex-direction: column; gap: 0.2rem; }
  .company { font-weight: 700; font-size: 1rem; color: var(--text); line-height: 1.2; }
  .job-title { font-size: 0.9rem; color: var(--accent); font-weight: 500; }

  .job-right { display: flex; flex-direction: column; align-items: flex-end; gap: 0.15rem; flex-shrink: 0; }
  .badge {
    display: inline-block;
    padding: 0.1rem 0.55rem;
    background: var(--accent);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: 999px;
    margin-bottom: 0.2rem;
  }
  .period { font-size: 0.82rem; color: var(--text-secondary); font-weight: 500; }
  .loc { font-size: 0.78rem; color: var(--muted); }

  .bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding-left: 0;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }
  .bullets li {
    font-size: 0.9rem;
    color: var(--text-secondary);
    padding-left: 1rem;
    position: relative;
    line-height: 1.65;
  }
  .bullets li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-size: 0.7rem;
    top: 0.2em;
  }

  @media (max-width: 500px) {
    .job { padding: 1.1rem; }
    .job-right { align-items: flex-start; }
  }
</style>
