---
const groups = [
  {
    label: 'Languages',
    skills: ['Kotlin', 'Java', 'TypeScript', 'C++', 'C#'],
  },
  {
    label: 'Databases',
    skills: ['DynamoDB', 'PostgreSQL'],
  },
  {
    label: 'Cloud & Infra',
    skills: ['AWS', 'Pinpoint', 'SES', 'EventBridge', 'Apache Pulsar', 'Apache Camel'],
  },
  {
    label: 'Identity & Auth',
    skills: ['Okta', 'OAuth 2.0', 'SSO', 'RLS', 'MFA'],
  },
  {
    label: 'Observability',
    skills: ['New Relic', 'Datadog', 'Splunk', 'Sentry', 'CloudWatch'],
  },
  {
    label: 'Engineering',
    skills: ['System Design', 'Design Patterns', 'Distributed Systems'],
  },
];
---
<section id="skills" class="container">
  <p class="section-label">Skills</p>
  <div class="groups">
    {groups.map(g => (
      <div class="group">
        <p class="group-label">{g.label}</p>
        <div class="pills">
          {g.skills.map(s => <span class="pill">{s}</span>)}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  section { background: var(--bg); }
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }
  .group {
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
  }
  .group-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  .pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .pill {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0.2rem 0.6rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-weight: 500;
    transition: background 0.12s, border-color 0.12s, color 0.12s;
  }
  .pill:hover {
    background: var(--accent-subtle);
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
