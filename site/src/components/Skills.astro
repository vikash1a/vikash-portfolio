---
const groups = [
  {
    label: 'Languages',
    skills: ['Kotlin', 'Java', 'TypeScript', 'C++', 'C#'],
  },
  {
    label: 'Databases',
    skills: ['DynamoDB', 'PostgreSQL'],
  },
  {
    label: 'Cloud & Infra',
    skills: ['AWS (Pinpoint, EUS, SES, EventBridge)', 'Apache Pulsar', 'Apache Camel'],
  },
  {
    label: 'Identity & Auth',
    skills: ['Okta', 'OAuth 2.0', 'SSO', 'RLS'],
  },
  {
    label: 'Observability',
    skills: ['New Relic', 'Datadog', 'Splunk', 'Sentry', 'CloudWatch'],
  },
  {
    label: 'Engineering',
    skills: ['System Design', 'Design Patterns'],
  },
];
---
<section id="skills" class="container">
  <h2>Skills</h2>
  <div class="groups">
    {groups.map(g => (
      <div class="group">
        <span class="group-label">{g.label}</span>
        <div class="pills">
          {g.skills.map(s => <span class="pill">{s}</span>)}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .groups { display: flex; flex-direction: column; gap: 1rem; }
  .group { display: flex; align-items: flex-start; gap: 1rem; flex-wrap: wrap; }
  .group-label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    min-width: 110px;
    padding-top: 0.3rem;
    flex-shrink: 0;
  }
  .pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .pill {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.25rem 0.65rem;
    font-size: 0.82rem;
    color: var(--text);
  }
</style>
