---
import data from '../data/resume.json';
const base = import.meta.env.BASE_URL;
const p = data.personal;
---
<section id="contact" class="container">
  <p class="section-label">Contact</p>
  <div class="contact-card">
    <div class="contact-text">
      <h2>Let's work together</h2>
      <p>Open to senior / staff backend roles and interesting distributed systems problems.</p>
    </div>
    <div class="contact-links">
      <a href={`mailto:${p.email}`} class="link-row">
        <span class="link-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        </span>
        <span>{p.email}</span>
      </a>
      <a href={`https://${p.linkedin}`} target="_blank" rel="noopener" class="link-row">
        <span class="link-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
        </span>
        <span>{p.linkedin}</span>
      </a>
      <a href={`${base}/Resume_Vikash_Sinha.pdf`} target="_blank" rel="noopener" class="link-row dl">
        <span class="link-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        </span>
        <span>Download Resume (PDF)</span>
      </a>
    </div>
  </div>
</section>

<style>
  section { background: var(--bg-white); }
  .contact-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem 2.25rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2.5rem;
    align-items: start;
  }
  .contact-text h2 { font-size: 1.25rem; font-weight: 700; color: var(--text); margin-bottom: 0.4rem; letter-spacing: -0.01em; }
  .contact-text p { font-size: 0.9rem; color: var(--muted); line-height: 1.6; }
  .contact-links { display: flex; flex-direction: column; gap: 0.65rem; flex-shrink: 0; }
  .link-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-weight: 500;
    transition: color 0.15s;
  }
  .link-row:hover { color: var(--accent); }
  .link-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    flex-shrink: 0;
    color: var(--muted);
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .link-row:hover .link-icon { background: var(--accent-subtle); border-color: var(--accent); color: var(--accent); }
  .dl { color: var(--accent); font-weight: 600; }
  .dl .link-icon { background: var(--accent-subtle); border-color: var(--accent); color: var(--accent); }

  @media (max-width: 640px) {
    .contact-card { grid-template-columns: 1fr; gap: 1.5rem; padding: 1.5rem; }
  }
</style>
