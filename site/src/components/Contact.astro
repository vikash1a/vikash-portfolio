---
const base = import.meta.env.BASE_URL;
---
<section id="contact" class="container">
  <h2>Contact</h2>
  <div class="links">
    <a href="mailto:vikash1a2b3c@gmail.com">vikash1a2b3c@gmail.com</a>
    <a href="https://linkedin.com/in/vikash-sinha-583124151" target="_blank" rel="noopener">LinkedIn</a>
    <a href={`${base}/Resume_Vikash_Sinha.pdf`} target="_blank" rel="noopener" class="dl-btn">Download Resume</a>
  </div>
</section>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: center;
  }
  .links a {
    font-size: 0.95rem;
    color: var(--accent-light);
  }
  .dl-btn {
    padding: 0.4rem 1rem;
    border: 1px solid var(--accent);
    border-radius: 4px;
    font-weight: 500;
    font-size: 0.9rem;
    transition: background 0.15s;
  }
  .dl-btn:hover {
    background: var(--accent);
    color: #fff;
    text-decoration: none;
  }
</style>
